      </svg>
    </div>
  </div>

  <section class="bordered" id="pricing-section">
    <div class="section-head">
      <span class="eyebrow-small">pricing</span>
      <h2>Built for the Indian market</h2>
      <p>Simple plans, billed in rupees. Upgrade, downgrade, or cancel whenever you like.</p>
    </div>
    <div class="pricing-grid">
      <div class="plan-card">
        <div class="plan-name">Starter</div>
        <div class="plan-price">₹0<span class="per">/month</span></div>
        <ul class="plan-features">
          <li>Everyday chat for quick questions</li>
          <li>Standard response speed</li>
          <li>Chat history within a session</li>
        </ul>
        <button class="btn" onclick="goTo('login')">Continue free</button>
      </div>
      <div class="plan-card featured">
        <span class="plan-tag">Most chosen</span>
        <div class="plan-name">Plus</div>
        <div class="plan-price">₹699<span class="per">/month</span></div>
        <div class="plan-gst">+ 18% GST</div>
