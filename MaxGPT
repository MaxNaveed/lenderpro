</div>

<div id="view-app">
  <header>
    <div class="brand">
      <div class="wordmark" onclick="goTo('landing')">MAX<span class="glyph">⌁</span>GPT</div>
      <span class="powered-tag">powered by maxnaveed</span>
    </div>
    <div class="header-right">
      <span class="badge">premium · unlimited</span>
      <button class="icon-btn" id="new-chat" type="button">New chat</button>
      <button class="icon-btn" onclick="goTo('landing')" type="button">Log out</button>
    </div>
  </header>

  <main id="chat-main">
    <div class="chat-inner" id="chat-inner">
      <div class="empty-state" id="empty-state">
        <svg class="infinity-mark" viewBox="0 0 64 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 16c0-6 5-10 10-6 4 3 6 9 6 9s2 6 6 9c5 4 10 0 10-6s-5-10-10-6c-4 3-6 9-6 9s-2 6-6 9c-5 4-10 0-10-6z"
                fill="none" stroke="#F2A93B" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
        <h1>No quota. No countdown.</h1>
        <p>Say whatever's on your mind — Max GPT doesn't ration the conversation. Type below to start.</p>
      </div>
    </div>
  </main>

  <div class="input-bar-wrap">
    <div class="input-bar">
      <textarea id="composer" rows="1" placeholder="Message Max GPT…" aria-label="Message Max GPT"></textarea>
      <svg class="infinity-loop" viewBox="0 0 30 18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M7 9c0-3 2.5-5 5-3 2 1.5 3 4.5 3 4.5s1 3 3 4.5c2.5 2 5 0 5-3s-2.5-5-5-3c-2 1.5-3 4.5-3 4.5s-1 3-3 4.5c-2.5 2-5 0-5-3z"/>
      </svg>
      <button id="send-btn" type="button" aria-label="Send message">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="19" x2="12" y2="5"></line>
          <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
      </button>
    </div>
    <div class="footnote">your conversation saves automatically · powered by maxnaveed</div>
  </div>
</div>

<script>
  function goTo(view){
    document.getElementById('view-landing').style.display = view === 'landing' ? 'block' : 'none';
    document.getElementById('view-login').style.display = view === 'login' ? 'flex' : 'none';
    document.getElementById('view-app').style.display = view === 'app' ? 'flex' : 'none';
    window.scrollTo(0,0);
    if(view === 'app'){ document.getElementById('composer').focus(); }
  }
  function scrollToSection(id){
    goTo('landing');
    setTimeout(() => { document.getElementById(id).scrollIntoView({ behavior:'smooth' }); }, 0);
  }

  async function enterApp(){
    goTo('app');
    await loadHistory();
  }

  const chatInner = document.getElementById('chat-inner');
  const emptyState = document.getElementById('empty-state');
  const composer = document.getElementById('composer');
  const sendBtn = document.getElementById('send-btn');
  const newChatBtn = document.getElementById('new-chat');
  const chatMain = document.getElementById('chat-main');

  let history = [];
  let isStreaming = false;

  function scrollToBottom(){ chatMain.scrollTop = chatMain.scrollHeight; }
  function clearEmptyState(){ if(emptyState && emptyState.parentNode){ emptyState.remove(); } }

  async function loadHistory(){
    try{
      const result = await window.storage.get('chat-history', false);
      if(result && result.value){
        const saved = JSON.parse(result.value);
        if(Array.isArray(saved) && saved.length){
          history = saved;
          chatInner.innerHTML = '';
          saved.forEach(m => addBubble(m.role, m.content));
        }
      }
    }catch(err){
      // nothing saved yet, or storage unavailable on this host — start fresh
    }
  }

  async function saveHistory(){
    try{
      await window.storage.set('chat-history', JSON.stringify(history), false);
    }catch(err){
      // saving failed silently — chat still works, it just won't persist
    }
  }

  function addBubble(role, text){
    clearEmptyState();
    const row = document.createElement('div');
    row.className = 'row ' + role;
    const wrap = document.createElement('div');
    const label = document.createElement('span');
    label.className = 'sender-label';
    label.textContent = role === 'user' ? 'you' : 'max gpt';
    const bubble = document.createElement('div');
    bubble.className = 'bubble';
    bubble.textContent = text;
    wrap.appendChild(label);
    wrap.appendChild(bubble);
    row.appendChild(wrap);
    chatInner.appendChild(row);
    scrollToBottom();
    return bubble;
  }

  function addTypingIndicator(){
    clearEmptyState();
    const row = document.createElement('div');
    row.className = 'row assistant';
    row.id = 'typing-row';
    const wrap = document.createElement('div');
    const label = document.createElement('span');
    label.className = 'sender-label';
    label.textContent = 'max gpt';
    const bubble = document.createElement('div');
    bubble.className = 'bubble';
    bubble.innerHTML = '<span class="typing"><span></span><span></span><span></span></span>';
    wrap.appendChild(label);
    wrap.appendChild(bubble);
    row.appendChild(wrap);
    chatInner.appendChild(row);
    scrollToBottom();
  }
  function removeTypingIndicator(){
    const row = document.getElementById('typing-row');
    if(row) row.remove();
  }
  function addErrorBubble(message){
    clearEmptyState();
    const row = document.createElement('div');
    row.className = 'row assistant';
    const wrap = document.createElement('div');
    const bubble = document.createElement('div');
    bubble.className = 'bubble';
    bubble.innerHTML = '<span class="error-text">' + message + '</span>';
    wrap.appendChild(bubble);
    row.appendChild(wrap);
    chatInner.appendChild(row);
    scrollToBottom();
  }

  async function sendMessage(){
    const text = composer.value.trim();
    if(!text || isStreaming) return;
    isStreaming = true;
    sendBtn.disabled = true;
    composer.value = '';
    composer.style.height = 'auto';
    addBubble('user', text);
    history.push({ role: 'user', content: text });
    addTypingIndicator();
    try{
      const response = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: 'claude-sonnet-4-6',
          max_tokens: 1000,
          system: 'You are Max GPT, a friendly and capable AI assistant. Be direct, warm, and helpful.',
          messages: history
        })
      });
      const data = await response.json();
      removeTypingIndicator();
      const textBlocks = (data.content || []).filter(b => b.type === 'text').map(b => b.text);
      const replyText = textBlocks.join('\n').trim();
      if(replyText){
        addBubble('assistant', replyText);
        history.push({ role: 'assistant', content: replyText });
        await saveHistory();
      } else {
        addErrorBubble('No response came back. Try sending that again.');
      }
    } catch(err){
      removeTypingIndicator();
      addErrorBubble('Something went wrong reaching Max GPT. Check your connection and try again.');
    } finally {
      isStreaming = false;
      sendBtn.disabled = false;
      composer.focus();
    }
  }

  sendBtn.addEventListener('click', sendMessage);
  composer.addEventListener('keydown', (e) => {
    if(e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); sendMessage(); }
  });
  composer.addEventListener('input', () => {
    composer.style.height = 'auto';
    composer.style.height = Math.min(composer.scrollHeight, 160) + 'px';
  });
  newChatBtn.addEventListener('click', async () => {
    history = [];
    chatInner.innerHTML = '';
    chatInner.appendChild(emptyState);
    composer.value = '';
    composer.style.height = 'auto';
    try{ await window.storage.delete('chat-history', false); }catch(err){ /* nothing to delete */ }
    composer.focus();
  });
</script>

</body>
</html>
